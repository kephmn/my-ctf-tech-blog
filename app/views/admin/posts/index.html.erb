<div class="max-w-3xl mx-auto py-10">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold">Admin: Posts</h1>
        <%= link_to "New Post", new_admin_post_path, class: "bg-blue-500 text-white px-4 py-2 rounded" %>
    </div>

    <table class="w-full border-collapse">
        <thead>
            <tr class="bg-gray-100">
                <th class="border p-2 text-left">Title</th>
                <th class="border p-2 text-left">Status</th>

            </tr>
        </thead>
        <tbody>
            <% @posts.each do |post| %>
                <tr class="border-b hover:bg-gray-50">
                    <td class="border p-2">
                        <%= link_to post.title, admin_post_path(post), class: "text-blue-500 hover:underline" %>
                    </td>
                    <td class="border p-2">
                        <%= post.published? ? "Published" : "Draft" %>
                    </td>
                    <td class="text-right space-x-2">
                        <%= link_to "Edit", edit_admin_post_path(post), class: "text-blue-500 hover:underline mr-2" %>
                        <%= link_to "Delete", admin_post_path(post), method: :delete, data: { turbo_method: :delete, turbo_confirm: "Do you want to delete this post?" } %>
                    </td>
                </tr>
            <% end %>
        </tbody>
    </table>
</div>
