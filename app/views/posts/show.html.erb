<article class="prose max-w-3xl mx-auto py-10">
  <p class="text-sm text-gray-500">
    <%= @post.category %> • <%= @post.created_at.strftime("%B %d, %Y") %>
  </p>

  <h1><%= @post.title %></h1>
  <div class="mb-4">
    <% @post.tags.each do |tag| %>
      <% link_to "##{tag.name}", root_path(tag: tag.name),
          class: "text-sm bg-gray-100 rounded px-2 py-1 mr-1" %>
    <% end %>
  </div>

  <%= markdown(@post.body) %>
</article>